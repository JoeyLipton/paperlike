# Builds paperlike from the checkout this file lives in:
#
#   cd packaging/arch && makepkg -si
#
# To publish on the AUR, point `source` at the public git repository instead.

pkgname=paperlike-git
pkgver=1.0.1
pkgrel=1
pkgdesc='Paper-like texture overlay for X11 desktops'
arch=('x86_64' 'aarch64')
license=('MIT OR Apache-2.0')
depends=('gcc-libs' 'glibc')
makedepends=('cargo' 'git')
optdepends=('picom: compositor, needed for the overlay to show')
provides=('paperlike')
conflicts=('paperlike')
# Cargo already strips the binary (see Cargo.toml), so there's nothing for a -debug package.
options=('!debug')
source=("paperlike::git+file://${startdir}/../..")
sha256sums=('SKIP')

pkgver() {
  cd paperlike
  local version
  version=$(grep -m1 '^version' Cargo.toml | cut -d'"' -f2)
  printf '%s.r%s.g%s' "$version" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

# RUSTUP_TOOLCHAIN is deliberately left alone: with rustup, the repo's
# rust-toolchain.toml picks the compiler; with Arch's rust package it's ignored.

prepare() {
  cd paperlike
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd paperlike
  CARGO_TARGET_DIR=target cargo build --frozen --release
}

check() {
  cd paperlike
  cargo test --frozen
}

package() {
  cd paperlike
  install -Dm755 target/release/paperlike -t "$pkgdir/usr/bin/"
  install -Dm644 assets/paperlike.desktop -t "$pkgdir/usr/share/applications/"
  install -Dm644 doc/paperlike.1 -t "$pkgdir/usr/share/man/man1/"
  install -Dm644 README.md -t "$pkgdir/usr/share/doc/$pkgname/"
  install -Dm644 LICENSE-MIT LICENSE-APACHE assets/fonts/*.txt -t "$pkgdir/usr/share/licenses/$pkgname/"
}
